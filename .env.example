# Supabase project URL from Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe Supabase publishable key. Never use a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Netlify Function server environment. Never prefix these with VITE_.
# Configure them in Netlify, or in a local Netlify environment file.
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
